server {
    listen 80;
    server_name 187.127.119.213 www.pustakapublik.info;

    # Setting untuk Frontend (React/Vite)
    root /var/www/portal-berita/frontend;
    index index.html index.htm;

    location / {
        try_files $uri $uri/ /index.html; # Penting agar react-router tidak 404
    }

    # Setting Reverse Proxy untuk API (Backend Express)
    location /api {
        proxy_pass http://localhost:5050; # Sesuaikan port backend Anda
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }
}
